{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile"
  },
  "deploy": {
    "numReplicas": 1,
    "sleepApplication": false
  },
  "cron": {
    "sector-collector": {
      "schedule": "0 2 * * *",
      "command": "PYTHONPATH=. python3 scripts/mri_aae_prod.py"
    }
  }
}
